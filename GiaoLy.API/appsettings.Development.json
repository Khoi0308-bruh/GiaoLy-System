{
  // Cổng dev của hai app Nuxt: 3000/3001 khi chạy `pnpm dev`, 4000/4001 khi chạy bản build
  // (`nuxt build` + `node .output/server/index.mjs`). Thiếu cổng nào thì trình duyệt ở cổng
  // đó bị CORS chặn và trang đăng nhập báo lỗi mà không nói rõ nguyên nhân.
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000",
      "http://localhost:3001",
      "http://localhost:4000",
      "http://localhost:4001"
    ]
  },
  "RateLimiting": {
    "Global": {
      "PermitLimit": 600,
      "WindowSeconds": 60
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
