#!/bin/sh
basedir=$(dirname "$(echo "$0" | sed -e 's,\\,/,g')")

case `uname` in
    *CYGWIN*|*MINGW*|*MSYS*)
        if command -v cygpath > /dev/null 2>&1; then
            basedir=`cygpath -w "$basedir"`
        fi
    ;;
esac

if [ -z "$NODE_PATH" ]; then
  export NODE_PATH="/mnt/c/GiaoLy/web-app/node_modules/.pnpm/@nuxt+ui@4.10.0_aeb4c7554c86154b9f9155eff3966ecf/node_modules/@nuxt/ui/node_modules:/mnt/c/GiaoLy/web-app/node_modules/.pnpm/@nuxt+ui@4.10.0_aeb4c7554c86154b9f9155eff3966ecf/node_modules:/mnt/c/GiaoLy/web-app/node_modules/.pnpm/node_modules"
else
  export NODE_PATH="/mnt/c/GiaoLy/web-app/node_modules/.pnpm/@nuxt+ui@4.10.0_aeb4c7554c86154b9f9155eff3966ecf/node_modules/@nuxt/ui/node_modules:/mnt/c/GiaoLy/web-app/node_modules/.pnpm/@nuxt+ui@4.10.0_aeb4c7554c86154b9f9155eff3966ecf/node_modules:/mnt/c/GiaoLy/web-app/node_modules/.pnpm/node_modules:$NODE_PATH"
fi
if [ -x "$basedir/node" ]; then
  exec "$basedir/node"  "$basedir/../../cli/index.mjs" "$@"
else
  exec node  "$basedir/../../cli/index.mjs" "$@"
fi
