{"file":"login-BdLL3V6Q.js","mappings":";;;;;;;;;;;;;;;;;EA+GA,eAAe,EAAE,QAAQ,MAAM,CAAC;EACnB,aAAa;EACZ,SAAS;EACvB,MAAM,WAAA,GAAA,YAAA,IAAA,CAAc,KAAK;EACzB,MAAM,QAAA,GAAA,YAAA,SAAA,CAAgB;GAAE,UAAU;GAAI,UAAU;EAAG,CAAC;EACrC,iBAAiB;;;;;;;0FAlHzB,OAAM,uEAAsE,GAAA,MAAA,CAAA,EAAA,uhBAAA;;IAazE,MAAK;IACL,OAAM;;wsBAkBR,EAAA,mBAAA,OAAA,CAA8B,EAAA,kCAAA;;IAI1B,IAAG;IACH,OAAM;;uCAMG,GAAA,OAAA,SAAA,aAAA;;MAHP,MAAK;MACL,OAAM;;+CACN,kBAAA;MAFA,MAAK;MACL,OAAM;;;;;;;IAgBR,OAAM;IACN,MAAK;;uCAYM,GAAA,OAAA,SAAA,aAAA;;yCATA,IAAA,CAAI,CAAC;gEAAL,IAAA,CAAI,CAAC,WAAQ;MACtB,MAAK;MACL,aAAY;MACZ,MAAK;MACL,OAAM;MACN,SAAQ;MACR,WAAA;MACC,IAAI,EAAA,MAAA,oFAAA;;+CACL,mBAAA;yCARS,IAAA,CAAI,CAAC;gEAAL,IAAA,CAAI,CAAC,WAAQ;MACtB,MAAK;MACL,aAAY;MACZ,MAAK;MACL,OAAM;MACN,SAAQ;MACR,WAAA;MACC,IAAI,EAAA,MAAA,oFAAA;;;;;;IAKP,OAAM;IACN,MAAK;;uCAYM,GAAA,OAAA,SAAA,aAAA;;yCATA,IAAA,CAAI,CAAC;gEAAL,IAAA,CAAI,CAAC,WAAQ;MACtB,MAAK;MACL,MAAK;MACL,aAAY;MACZ,MAAK;MACL,OAAM;MACN,SAAQ;MACP,IAAI,EAAA,MAAA,oFAAA;;+CACL,mBAAA;yCARS,IAAA,CAAI,CAAC;gEAAL,IAAA,CAAI,CAAC,WAAQ;MACtB,MAAK;MACL,MAAK;MACL,aAAY;MACZ,MAAK;MACL,OAAM;MACN,SAAQ;MACP,IAAI,EAAA,MAAA,oFAAA;;;;;;IAKP,MAAK;IACL,OAAA;IACA,OAAM;IACN,MAAK;IACJ,UAAA,GAAA,YAAA,MAAA,CAAS,OAAA;IACV,OAAM;;uCAGE,GAAA,OAAA,SAAA,aAAA;;mDAFT,gBAED,CAAA;;;;8IAIiB,KAAI,EAAA,CAAG,YAAW,CAAA,EAAA,4CAAA","names":[],"sources":["../../../../../../../pages/login.vue"],"sourcesContent":["<!-- eslint-disable vue/multi-word-component-names -->\r\n<template>\r\n  <div class=\"min-h-screen flex flex-col md:flex-row bg-stone-50 dark:bg-stone-900\">\r\n    <!-- Nửa trái: Nghệ thuật thị giác -->\r\n    <div class=\"hidden md:flex md:w-1/2 lg:w-3/5 relative bg-stone-900 overflow-hidden items-center justify-center\">\r\n      <!-- Background Image -->\r\n      <img\r\n        src=\"https://images.unsplash.com/photo-1438032005730-c779502df39b?q=80&w=2000&auto=format&fit=crop\"\r\n        class=\"absolute inset-0 w-full h-full object-cover opacity-30 blur-[2px] transition-all duration-1000\"\r\n        alt=\"Church Interior\"\r\n      >\r\n      <div class=\"absolute inset-0 bg-gradient-to-tr from-marian-blue-950/90 via-marian-blue-900/60 to-transparent\" />\r\n\r\n      <div class=\"relative z-10 p-12 text-center animate-fade-in-up\">\r\n        <UIcon\r\n          name=\"i-heroicons-sparkles\"\r\n          class=\"w-16 h-16 text-vatican-gold-400 mx-auto mb-6 drop-shadow-lg\"\r\n        />\r\n        <h1 class=\"font-serif text-5xl lg:text-6xl font-black text-white leading-tight mb-6 drop-shadow-md\">\r\n          Ánh Sáng <br><span class=\"text-vatican-gold-400\">Tân Phúc Âm Hóa</span>\r\n        </h1>\r\n        <p class=\"text-stone-300 text-lg italic max-w-md mx-auto drop-shadow-md\">\r\n          \"Cứ để trẻ em đến với Thầy, đừng ngăn cấm chúng, vì Nước Thiên Chúa là của những ai giống như chúng.\"\r\n        </p>\r\n      </div>\r\n    </div>\r\n\r\n    <!-- Nửa phải: Form Login -->\r\n    <div class=\"w-full md:w-1/2 lg:w-2/5 flex items-center justify-center p-8 lg:p-16 relative\">\r\n      <!-- Subtle background glow -->\r\n      <div class=\"absolute inset-0 bg-gradient-to-br from-marian-blue-50/50 to-white dark:from-stone-900 dark:to-stone-950 -z-10\" />\r\n\r\n      <div\r\n        class=\"w-full max-w-sm animate-fade-in-up\"\r\n        style=\"animation-delay: 0.2s;\"\r\n      >\r\n        <div class=\"text-center mb-10\">\r\n          <NuxtLink\r\n            to=\"/\"\r\n            class=\"inline-block p-2 rounded-xl bg-primary-50 dark:bg-stone-800 text-primary-600 mb-6 hover:scale-105 transition-transform\"\r\n          >\r\n            <UIcon\r\n              name=\"i-heroicons-home\"\r\n              class=\"w-6 h-6\"\r\n            />\r\n          </NuxtLink>\r\n          <h2 class=\"text-3xl font-black text-stone-800 dark:text-white uppercase tracking-wider mb-2\">\r\n            Đăng Nhập\r\n          </h2>\r\n          <p class=\"text-stone-500 text-sm\">\r\n            Cổng thông tin quản trị Sứ đoàn Thiếu Nhi Thánh Thể\r\n          </p>\r\n        </div>\r\n\r\n        <form\r\n          class=\"space-y-6\"\r\n          @submit.prevent=\"handleLogin\"\r\n        >\r\n          <UFormField\r\n            label=\"Tên đăng nhập\"\r\n            name=\"username\"\r\n          >\r\n            <UInput\r\n              v-model=\"form.username\"\r\n              icon=\"i-heroicons-user\"\r\n              placeholder=\"Nhập tài khoản\"\r\n              size=\"xl\"\r\n              class=\"w-full\"\r\n              variant=\"soft\"\r\n              autofocus\r\n              :ui=\"{ base: 'focus:ring-2 focus:ring-primary-500 dark:focus:ring-primary-400 transition-shadow' }\"\r\n            />\r\n          </UFormField>\r\n\r\n          <UFormField\r\n            label=\"Mật khẩu\"\r\n            name=\"password\"\r\n          >\r\n            <UInput\r\n              v-model=\"form.password\"\r\n              type=\"password\"\r\n              icon=\"i-heroicons-lock-closed\"\r\n              placeholder=\"••••••••\"\r\n              size=\"xl\"\r\n              class=\"w-full\"\r\n              variant=\"soft\"\r\n              :ui=\"{ base: 'focus:ring-2 focus:ring-primary-500 dark:focus:ring-primary-400 transition-shadow' }\"\r\n            />\r\n          </UFormField>\r\n\r\n          <UButton\r\n            type=\"submit\"\r\n            block\r\n            color=\"primary\"\r\n            size=\"xl\"\r\n            :loading=\"loading\"\r\n            class=\"mt-8 font-bold tracking-wide shadow-sm\"\r\n          >\r\n            Vào Hệ Thống\r\n          </UButton>\r\n        </form>\r\n\r\n        <div class=\"mt-8 text-center text-xs text-stone-400\">\r\n          <p>&copy; {{ new Date().getFullYear() }} GiaoLy Vision.</p>\r\n        </div>\r\n      </div>\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script setup>\r\ndefinePageMeta({ layout: false }) // Tắt layout mặc định cho trang login\r\nconst auth = useAuthStore()\r\nconst toast = useToast()\r\nconst loading = ref(false)\r\nconst form = reactive({ username: '', password: '' })\r\nconst config = useRuntimeConfig()\r\n\r\nconst handleLogin = async () => {\r\n  loading.value = true\r\n  try {\r\n    const res = await $fetch(`${config.public.apiBase}/Auth/login`, {\r\n      method: 'POST',\r\n      body: form\r\n    })\r\n    auth.setAuth(res)\r\n    navigateTo('/') // Đăng nhập xong về trang chủ\r\n  } catch {\r\n    toast.add({ \r\n      title: 'Đăng nhập thất bại', \r\n      description: 'Sai tài khoản hoặc mật khẩu!', \r\n      color: 'red', \r\n      icon: 'i-heroicons-x-circle' \r\n    })\r\n  } finally {\r\n    loading.value = false\r\n  }\r\n}\r\n</script>\r\n"],"version":3}