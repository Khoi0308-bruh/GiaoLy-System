CAA+B,GAAA,EAAA,GAAA,YAAA,YAAA,CAOtC,oBAAA;WALA,MAAK;WACL,OAAM;WACN,SAAQ;WACR,MAAK;WACJ,UAAA,GAAA,YAAA,cAAA,EAAK,WAAO,aAAa,IAAI,GAAA,CAAA,MAAA,CAAA;iEAQ9B,oBAAA;WALA,MAAK;WACL,OAAM;WACN,SAAQ;WACR,MAAK;WACJ,UAAA,GAAA,YAAA,cAAA,EAAK,WAAO,WAAW,KAAK,EAAE,GAAA,CAAA,MAAA,CAAA;;;;;;;8BAUlC,YAAA,KAAY,EAAA,GAAA,YAAA,MAAA,CAAK,UAAA,CAAU,EAAE,WAAA,GAAA,YAAA,UAAA,CAAA,IAAA,GAAA,YAAA,YAAA,CAUhC,OAAA;;OATJ,OAAM;uCAKJ,kBAAA;OAFA,MAAK;OACL,OAAM;uCAIJ,KAAA,EAFD,OAAM,UAAS,GAAC,4CAEnB,CAAA,CAAA,MAAA,GAAA,YAAA,mBAAA,CAAA,IAAA,IAAA;mCAkEO,mBAAA;OA7DC,OAAA,GAAA,YAAA,MAAA,CAAM,YAAA;2EAAA,aAAY,QAAA,SAAA;OAC1B,OAAM;;OAEK,OAAA,GAAA,YAAA,QAAA,OAwCF,EAAA,GAAA,YAAA,YAAA,CAAA,QAAA;QAtCL,IAAG;QACH,OAAM;QACL,WAAA,GAAA,YAAA,cAAA,CAAgB,YAAU,CAAA,SAAA,CAAA;;qCAWd,uBAAA;SARX,OAAM;SACN,UAAA;;iDAME,EAAA,GAAA,YAAA,YAAA,CAAA,mBAAA;6CAHS,QAAA,CAAQ,CAAC;oEAAT,QAAA,CAAQ,CAAC,YAAS;UAC3B,aAAY;UACZ,OAAM;;;;qCAkBJ,OAAA,EAfD,OAAM,yBAAwB,GAAA,EAAA,GAAA,YAAA,YAAA,CAOpB,uBAAA,EAND,OAAM,QAAO,GAAA;iDAKrB,EAAA,GAAA,YAAA,YAAA,CAAA,oBAAA;6CAHS,QAAA,CAAQ,CAAC;oEAAT,QAAA,CAAQ,CAAC,SAAM;UACvB,UAAA,GAAA,YAAA,MAAA,CAAS,aAAA;UACV,OAAM;;;;;;;yCASG,uBAAA,EAND,OAAM,mBAAkB,GAAA;iDAKhC,EAAA,GAAA,YAAA,YAAA,CAAA,mBAAA;6CAHS,QAAA,CAAQ,CAAC;oEAAT,QAAA,CAAQ,CAAC,WAAQ;UAC1B,aAAY;UACZ,OAAM;;;;qCAWC,uBAAA,EAPD,OAAM,sDAAqD,GAAA;iDAMnE,EAAA,GAAA,YAAA,YAAA,CAAA,oBAAA;6CAJS,QAAA,CAAQ,CAAC;oEAAT,QAAA,CAAQ,CAAC,WAAQ;UACzB,UAAA,GAAA,YAAA,MAAA,CAAS,WAAA;UACV,aAAY;UACZ,OAAM;;;;;;;;;OAKH,SAAA,GAAA,YAAA,QAAA,OAcH,EAAA,GAAA,YAAA,YAAA,CAAA,OAAA,EAbD,OAAM,yBAAwB,GAAA,EAAA,GAAA,YAAA,YAAA,CAM/B,oBAAA;QAJA,OAAM;QACN,OAAM;QACN,SAAQ;QACP,UAAK,WAAE,aAAA,QAAY;8DAOpB,oBAAA;QAJA,MAAK;QACL,MAAK;QACL,OAAM;QACL,UAAA,GAAA,YAAA,MAAA,CAAS,YAAA;;;;mCAoET,mBAAA;OA7DC,OAAA,GAAA,YAAA,MAAA,CAAM,UAAA;yEAAA,WAAU,QAAA,SAAA;OACxB,OAAM;;OAEK,OAAA,GAAA,YAAA,QAAA,OAwCF,EAAA,GAAA,YAAA,YAAA,CAAA,QAAA;QAtCL,IAAG;QACH,OAAM;QACL,WAAA,GAAA,YAAA,cAAA,CAAgB,YAAU,CAAA,SAAA,CAAA;;qCAWd,uBAAA;SARX,OAAM;SACN,UAAA;;iDAME,EAAA,GAAA,YAAA,YAAA,CAAA,mBAAA;6CAHS,YAAA,CAAY,CAAC;oEAAb,YAAA,CAAY,CAAC,YAAS;UAC/B,aAAY;UACZ,OAAM;;;;qCAkBJ,OAAA,EAfD,OAAM,yBAAwB,GAAA,EAAA,GAAA,YAAA,YAAA,CAOpB,uBAAA,EAND,OAAM,QAAO,GAAA;iDAKrB,EAAA,GAAA,YAAA,YAAA,CAAA,oBAAA;6CAHS,YAAA,CAAY,CAAC;oEAAb,YAAA,CAAY,CAAC,SAAM;UAC3B,UAAA,GAAA,YAAA,MAAA,CAAS,aAAA;UACV,OAAM;;;;;;;yCASG,uBAAA,EAND,OAAM,mBAAkB,GAAA;iDAKhC,EAAA,GAAA,YAAA,YAAA,CAAA,mBAAA;6CAHS,YAAA,CAAY,CAAC;oEAAb,YAAA,CAAY,CAAC,WAAQ;UAC9B,aAAY;UACZ,OAAM;;;;qCAWC,uBAAA,EAPD,OAAM,sDAAqD,GAAA;iDAMnE,EAAA,GAAA,YAAA,YAAA,CAAA,oBAAA;6CAJS,YAAA,CAAY,CAAC;oEAAb,YAAA,CAAY,CAAC,WAAQ;UAC7B,UAAA,GAAA,YAAA,MAAA,CAAS,WAAA;UACV,aAAY;UACZ,OAAM;;;;;;;;;OAKH,SAAA,GAAA,YAAA,QAAA,OAcH,EAAA,GAAA,YAAA,YAAA,CAAA,OAAA,EAbD,OAAM,yBAAwB,GAAA,EAAA,GAAA,YAAA,YAAA,CAM/B,oBAAA;QAJA,OAAM;QACN,OAAM;QACN,SAAQ;QACP,UAAK,WAAE,WAAA,QAAU;8DAOlB,oBAAA;QAJA,MAAK;QACL,MAAK;QACL,OAAM;QACL,UAAA,GAAA,YAAA,MAAA,CAAS,gBAAA","names":[],"sources":["../../../../../../../pages/admin/academic-years/[id].vue"],"sourcesContent":["<template>\n  <UContainer class=\"py-10 space-y-8\">\n    <!-- Breadcrumb -->\n    <div class=\"flex items-center gap-2 text-sm text-stone-500\">\n      <NuxtLink\n        to=\"/admin/academic-years\"\n        class=\"hover:text-primary-500 transition-colors\"\n      >\n        Niên Khóa\n      </NuxtLink>\n      <UIcon\n        name=\"i-heroicons-chevron-right\"\n        class=\"w-4 h-4\"\n      />\n      <span class=\"font-semibold text-stone-800 dark:text-white\">{{ year?.name ?? '...' }}</span>\n    </div>\n\n    <!-- Header -->\n    <div class=\"flex items-center justify-between\">\n      <div>\n        <h1 class=\"text-3xl font-black text-stone-800 dark:text-white\">\n          Lớp Học <span class=\"text-primary-500\">{{ year?.name }}</span>\n        </h1>\n        <p class=\"text-stone-500 text-sm mt-1\">\n          Quản lý danh sách lớp học trong niên khóa này.\n        </p>\n      </div>\n      <UButton\n        icon=\"i-heroicons-plus\"\n        label=\"Thêm Lớp Học\"\n        color=\"primary\"\n        @click=\"isCreateOpen = true\"\n      />\n    </div>\n\n    <!-- Loading -->\n    <div\n      v-if=\"pendingRooms\"\n      class=\"flex justify-center py-10\"\n    >\n      <UIcon\n        name=\"i-heroicons-arrow-path\"\n        class=\"w-8 h-8 animate-spin text-primary-500\"\n      />\n    </div>\n\n    <!-- Grid lớp học theo ngành -->\n    <div\n      v-for=\"branch in branches\"\n      :key=\"branch.id\"\n      class=\"space-y-3\"\n    >\n      <div class=\"flex items-center gap-3\">\n        <UBadge\n          :label=\"branch.name\"\n          :color=\"branch.color\"\n          variant=\"soft\"\n          size=\"lg\"\n        />\n        <span class=\"text-xs text-stone-400\">\n          {{ roomsByBranch(branch.id).length }} lớp\n        </span>\n      </div>\n\n      <div\n        v-if=\"roomsByBranch(branch.id).length === 0\"\n        class=\"text-sm text-stone-400 pl-2 italic\"\n      >\n        Chưa có lớp học nào.\n      </div>\n\n      <div class=\"grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4\">\n        <UCard\n          v-for=\"room in roomsByBranch(branch.id)\"\n          :key=\"room.id\"\n          class=\"hover:-translate-y-1 hover:shadow-md transition-all cursor-pointer group relative\"\n        >\n          <div class=\"flex items-start justify-between\">\n            <NuxtLink\n              :to=\"`/admin/classrooms/${room.id}`\"\n              class=\"flex-1 min-w-0\"\n            >\n              <h3 class=\"font-bold text-stone-800 dark:text-white text-lg hover:text-primary-500 transition-colors\">\n                {{ room.className }}\n              </h3>\n              <p class=\"text-sm text-stone-500 mt-1\">\n                <UIcon\n                  name=\"i-heroicons-user\"\n                  class=\"inline w-3 h-3 mr-1 text-primary-500\"\n                />\n                GLV: {{ room.mainTeacher || 'Chưa phân công' }}\n              </p>\n              <p\n                v-if=\"room.roomName\"\n                class=\"text-sm text-stone-500 mt-0.5\"\n              >\n                <UIcon\n                  name=\"i-heroicons-map-pin\"\n                  class=\"inline w-3 h-3 mr-1 text-amber-500\"\n                />\n                {{ room.roomName }}\n              </p>\n            </NuxtLink>\n            <div class=\"flex gap-1 ml-2 flex-shrink-0\">\n              <UButton\n                icon=\"i-heroicons-pencil-square\"\n                color=\"neutral\"\n                variant=\"ghost\"\n                size=\"xs\"\n                @click.stop=\"openEditRoom(room)\"\n              />\n              <UButton\n                icon=\"i-heroicons-trash\"\n                color=\"red\"\n                variant=\"ghost\"\n                size=\"xs\"\n                @click.stop=\"deleteRoom(room.id)\"\n              />\n            </div>\n          </div>\n        </UCard>\n      </div>\n    </div>\n\n    <!-- Empty state -->\n    <div\n      v-if=\"!pendingRooms && !classRooms?.length\"\n      class=\"text-center py-20 text-stone-400\"\n    >\n      <UIcon\n        name=\"i-heroicons-squares-2x2\"\n        class=\"w-14 h-14 mx-auto mb-4 opacity-30\"\n      />\n      <p class=\"text-lg\">\n        Chưa có lớp học nào trong niên khóa này.\n      </p>\n    </div>\n\n    <!-- Modal tạo lớp học -->\n    <UModal\n      v-model:open=\"isCreateOpen\"\n      title=\"Thêm Lớp Học Mới\"\n    >\n      <template #body>\n        <form\n          id=\"room-form\"\n          class=\"p-4 space-y-4\"\n          @submit.prevent=\"createRoom\"\n        >\n          <UFormField\n            label=\"Tên lớp\"\n            required\n          >\n            <UInput\n              v-model=\"roomForm.className\"\n              placeholder=\"Ví dụ: Khối Ấu 1 - Lớp A\"\n              class=\"w-full\"\n            />\n          </UFormField>\n          <div class=\"grid grid-cols-2 gap-4\">\n            <UFormField label=\"Ngành\">\n              <USelect\n                v-model=\"roomForm.branch\"\n                :options=\"branchOptions\"\n                class=\"w-full\"\n              />\n            </UFormField>\n            <UFormField label=\"Phòng / địa điểm\">\n              <UInput\n                v-model=\"roomForm.roomName\"\n                placeholder=\"Ví dụ: Phòng 3\"\n                class=\"w-full\"\n              />\n            </UFormField>\n          </div>\n          <UFormField label=\"Tài khoản GLV Chủ nhiệm (Dùng phân quyền nhập điểm)\">\n            <USelect\n              v-model=\"roomForm.leaderId\"\n              :options=\"userOptions\"\n              placeholder=\"-- Chọn tài khoản Giáo Lý Viên --\"\n              class=\"w-full\"\n            />\n          </UFormField>\n        </form>\n      </template>\n      <template #footer>\n        <div class=\"flex justify-end gap-3\">\n          <UButton\n            label=\"Hủy\"\n            color=\"neutral\"\n            variant=\"ghost\"\n            @click=\"isCreateOpen = false\"\n          />\n          <UButton\n            type=\"submit\"\n            form=\"room-form\"\n            label=\"Thêm lớp\"\n            :loading=\"isSubmitting\"\n          />\n        </div>\n      </template>\n    </UModal>\n    <!-- Modal chỉnh sửa lớp học -->\n    <UModal\n      v-model:open=\"isEditOpen\"\n      title=\"Cập Nhật Thông Tin Lớp Học\"\n    >\n      <template #body>\n        <form\n          id=\"edit-room-form\"\n          class=\"p-4 space-y-4\"\n          @submit.prevent=\"updateRoom\"\n        >\n          <UFormField\n            label=\"Tên lớp\"\n            required\n          >\n            <UInput\n              v-model=\"editRoomForm.className\"\n              placeholder=\"Ví dụ: Khối Ấu 1 - Lớp A\"\n              class=\"w-full\"\n            />\n          </UFormField>\n          <div class=\"grid grid-cols-2 gap-4\">\n            <UFormField label=\"Ngành\">\n              <USelect\n                v-model=\"editRoomForm.branch\"\n                :options=\"branchOptions\"\n                class=\"w-full\"\n              />\n            </UFormField>\n            <UFormField label=\"Phòng / địa điểm\">\n              <UInput\n                v-model=\"editRoomForm.roomName\"\n                placeholder=\"Ví dụ: Phòng 3\"\n                class=\"w-full\"\n              />\n            </UFormField>\n          </div>\n          <UFormField label=\"Tài khoản GLV Chủ nhiệm (Dùng phân quyền nhập điểm)\">\n            <USelect\n              v-model=\"editRoomForm.leaderId\"\n              :options=\"userOptions\"\n              placeholder=\"-- Chọn tài khoản Giáo Lý Viên --\"\n              class=\"w-full\"\n            />\n          </UFormField>\n        </form>\n      </template>\n      <template #footer>\n        <div class=\"flex justify-end gap-3\">\n          <UButton\n            label=\"Hủy\"\n            color=\"neutral\"\n            variant=\"ghost\"\n            @click=\"isEditOpen = false\"\n          />\n          <UButton\n            type=\"submit\"\n            form=\"edit-room-form\"\n            label=\"Cập nhật lớp\"\n            :loading=\"isEditSubmitting\"\n          />\n        </div>\n      </template>\n    </UModal>\n  </UContainer>\n</template>\n\n<script setup>\ndefinePageMeta({ layout: 'default' })\n\nconst route = useRoute()\nconst toast = useToast()\nconst yearId = route.params.id\n\nconst { data: year } = await useApiFetch(`/AcademicYear`)\nconst currentYear = computed(() => year.value?.find(y => y.id === yearId))\n\nconst { data: classRooms, pending: pendingRooms, refresh } = await useApiFetch(`/AcademicYear/${yearId}/classrooms`, {\n  default: () => []\n})\n\nconst { data: users } = await useApiFetch('/User')\nconst userOptions = computed(() => {\n  if (!users.value) return []\n  // Chỉ lấy những user có role 1, 2, 3 (Admin, Secretary, Mod) làm GLV\n  return users.value.map(u => ({\n    value: u.id,\n    label: u.fullName || u.username\n  }))\n})\n\nuseHead({ title: computed(() => `Lớp học - ${currentYear.value?.name ?? 'Niên khóa'} | GiaoLy`) })\n\nconst branches = [\n  { id: 1, name: 'Ấu Nhi', color: 'success' },\n  { id: 2, name: 'Thiếu Nhi', color: 'primary' },\n  { id: 3, name: 'Nghĩa Sĩ', color: 'warning' },\n  { id: 4, name: 'Hiệp Sĩ', color: 'error' }\n]\n\nconst branchOptions = branches.map(b => ({ value: b.id, label: b.name }))\n\nconst roomsByBranch = branchId => classRooms.value?.filter(r => r.branch === branchId) ?? []\n\nconst isCreateOpen = ref(false)\nconst isSubmitting = ref(false)\n\nconst roomForm = reactive({\n  className: '',\n  branch: 1,\n  mainTeacher: '',\n  leaderId: '',\n  roomName: ''\n})\n\n// Edit room\nconst isEditOpen = ref(false)\nconst isEditSubmitting = ref(false)\nconst currentEditRoomId = ref(null)\n\nconst editRoomForm = reactive({\n  className: '',\n  branch: 1,\n  mainTeacher: '',\n  leaderId: '',\n  roomName: ''\n})\n\nconst openEditRoom = (room) => {\n  currentEditRoomId.value = room.id\n  Object.assign(editRoomForm, {\n    className: room.className,\n    branch: room.branch,\n    mainTeacher: room.mainTeacher || '',\n    leaderId: room.leaderId || '',\n    roomName: room.roomName || ''\n  })\n  isEditOpen.value = true\n}\n\nconst updateRoom = async () => {\n  isEditSubmitting.value = true\n  try {\n    // Tự động gán mainTeacher text dựa trên user được chọn (để tương thích ngược với UI cũ)\n    const selectedUser = userOptions.value.find(u => u.value === editRoomForm.leaderId)\n    const teacherName = selectedUser ? selectedUser.label : ''\n\n    await $api(`/AcademicYear/classrooms/${currentEditRoomId.value}`, {\n      method: 'PUT',\n      body: {\n        id: currentEditRoomId.value,\n        academicYearId: yearId,\n        ...editRoomForm,\n        mainTeacher: teacherName,\n        leaderId: editRoomForm.leaderId || null,\n        branch: parseInt(editRoomForm.branch)\n      }\n    })\n    isEditOpen.value = false\n    await refresh()\n    toast.add({ title: 'Đã cập nhật lớp học!', color: 'success' })\n  } catch {\n    toast.add({ title: 'Lỗi khi cập nhật lớp học', color: 'error' })\n  } finally {\n    isEditSubmitting.value = false\n  }\n}\n\nconst createRoom = async () => {\n  isSubmitting.value = true\n  try {\n    const selectedUser = userOptions.value.find(u => u.value === roomForm.leaderId)\n    const teacherName = selectedUser ? selectedUser.label : ''\n\n    await $api(`/AcademicYear/${yearId}/classrooms`, {\n      method: 'POST',\n      body: {\n        ...roomForm,\n        mainTeacher: teacherName,\n        leaderId: roomForm.leaderId || null,\n        branch: parseInt(roomForm.branch)\n      }\n    })\n    isCreateOpen.value = false\n    Object.assign(roomForm, { className: '', branch: 1, mainTeacher: '', leaderId: '', roomName: '' })\n    await refresh()\n    toast.add({ title: 'Đã thêm lớp học!', color: 'success' })\n  } catch {\n    toast.add({ title: 'Lỗi khi tạo lớp học', color: 'error' })\n  } finally {\n    isSubmitting.value = false\n  }\n}\n\nconst deleteRoom = async (id) => {\n  if (!confirm('Xóa lớp học này?')) return\n  try {\n    await $api(`/AcademicYear/classrooms/${id}`, { method: 'DELETE' })\n    await refresh()\n    toast.add({ title: 'Đã xóa lớp học', color: 'success' })\n  } catch {\n    toast.add({ title: 'Lỗi khi xóa', color: 'error' })\n  }\n}\n</script>\n"],"version":3}